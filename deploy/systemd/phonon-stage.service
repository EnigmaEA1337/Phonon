[Unit]
Description=Phonon Stage Agent
Documentation=https://github.com/EnigmaEA1337/Phonon
After=network-online.target dbus.service avahi-daemon.service pipewire.service
Wants=network-online.target pipewire.service

[Service]
Type=exec
User=phonon
Group=phonon
ExecStartPre=+/bin/bash -c 'mkdir -p /run/user/%U && chown %u:%g /run/user/%U && chmod 700 /run/user/%U'
ExecStart=/opt/phonon/stage/.venv/bin/phonon-stage --config /etc/phonon/stage.yaml
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Restart=on-failure
RestartSec=5
WatchdogSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=phonon-stage

# Hardening (SECURITY.md §4.1)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/phonon /var/log/phonon
ReadOnlyPaths=/etc/phonon
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_BLUETOOTH
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
