[Unit]
Description=Phonon Stage Agent
Documentation=https://github.com/EnigmaEA1337/Phonon
After=network-online.target dbus.service avahi-daemon.service pipewire.service
Wants=network-online.target pipewire.service

[Service]
Type=exec
User=phonon
Group=phonon
ExecStartPre=+/bin/bash -c 'PH_UID=$$(id -u phonon) && mkdir -p /run/user/$$PH_UID && chown phonon:phonon /run/user/$$PH_UID && chmod 700 /run/user/$$PH_UID && echo "XDG_RUNTIME_DIR=/run/user/$$PH_UID" > /run/phonon-env && echo "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$$PH_UID/bus" >> /run/phonon-env'
EnvironmentFile=-/run/phonon-env
ExecStart=/opt/phonon/stage/.venv/bin/phonon-stage --config /etc/phonon/stage.yaml
Restart=on-failure
RestartSec=5
WatchdogSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=phonon-stage

# Hardening (SECURITY.md §4.1)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/phonon /var/log/phonon /run/user
ReadOnlyPaths=/etc/phonon
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_BLUETOOTH
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
